## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# VS Code directories
.vscode/

# Visual Studio cache
.vs/

# NuGet packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# DotCover
.idea/

# NCrunch
*.ncrunch*
.*crunch*.local.xml

# SQL Server database files
*.mdf
*.ldf

# Rider
.idea/

# User secrets
**/secrets.json

# IIS Express
/.vs/
/iisexpress/

# Others
*.dbmdl
*.bak
*.log
*.vspscc
*.vssscc
*.tmp

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper

# Entity Framework Migrations snapshot
*Migrations/*.Designer.cs

# Coverage results
TestResults/
*.coverage
*.coveragexml

# Azure deployments
.scm/

# Local history for JetBrains IDEs
.idea/

# Node.js dependencies
node_modules/

# Logs
*.log

# Publish output
publish/